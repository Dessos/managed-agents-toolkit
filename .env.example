# Anthropic API
# Required. Used by every cma command that hits the Managed Agents API.
ANTHROPIC_API_KEY=

# Webhook signing secret. Obtained from console.anthropic.com → Manage → Webhooks
# at endpoint creation. Shown only once — store securely.
ANTHROPIC_WEBHOOK_SIGNING_KEY=

# Public hostname your webhook receiver is reachable at (via Cloudflare Tunnel
# typically). Anthropic POSTs here. Replace with your own domain.
CMA_WEBHOOK_ENDPOINT=https://webhooks.example.com

# Public hostname for the local MCP bridge (cma-local-executor + bridged
# project MCP servers). Cloud agents connect here. Replace with your own.
CMA_MCP_BRIDGE_ENDPOINT=https://mcp.example.com

# Bearer token rotated by 'cma bridge rotate-token'. Persisted in vault as a
# static_bearer credential; this env var is the fallback for local dev.
CMA_MCP_BRIDGE_TOKEN=

# Optional: where telemetry JSONL lines are appended. Defaults to platform-
# appropriate temp dir if unset.
CMA_TELEMETRY_PATH=

# Optional: Prometheus Pushgateway URL for the [prometheus] extra.
PROMETHEUS_PUSHGATEWAY_URL=
