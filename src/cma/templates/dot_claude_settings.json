{
  "$schema-hint": "see docs/vault/knowledge/anthropic-docs/hooks.md for the full settings.json hook schema",
  "_comment": "Vault enforcement hooks (cma plan v4.1). Bypass via CMA_VAULT_BYPASS / CMA_VAULT_COMMIT_BYPASS / CMA_VAULT_STOP_BYPASS env vars (each logged).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m cma.vault.session_brief",
            "timeout": 10,
            "statusMessage": "Loading vault session brief..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python -m cma.vault.enforce_changelog",
            "timeout": 10,
            "statusMessage": "Validating ADR for new CHANGELOG decisions..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python -m cma.vault.check_adr_section_drift",
            "timeout": 5,
            "statusMessage": "Checking ADR section drift..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m cma.vault.check_session_writes",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
